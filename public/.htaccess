<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Use a single canonical host for SEO and force HTTPS.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.salaborovic\.com$ [NC]
  RewriteRule ^ https://salaborovic.com%{REQUEST_URI} [L,R=301]

  # Let real files and directories resolve normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send every other request to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>
